-
-    if let Some(id) = form.id {
-        if let Some(existing) = social.get_mut(id) {
-            *existing = item;
-        }
-    } else {
-        social.push(item);
-    }
-
-    social.sort_by_key(|item| item.posit);
-    match save_json_setting(&state, SEO_SOCIAL_KEY, &social).await {
-        Ok(()) => Redirect::to("/admin/seo/social").into_response(),
-        Err(e) => {
