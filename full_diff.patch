+        Ok(())
+    }
+
+    async fn query<'lua>(&self, lua: &'lua Lua, sql: String, _params: Option<serde_json::Value>) -> mlua::Result<mlua::Value> {
+        use sea_orm::{ConnectionTrait, Statement};
+        let db = self.db.as_ref();
+        let backend = db.get_database_backend();
+        
+        let stmt = Statement::from_string(backend, sql);
+        let rows = db.query_all(stmt).await.map_err(|e| mlua::Error::RuntimeError(e.to_string()))?;
+        
+        let mut results = Vec::new();
+        for row in rows {
+             let mut map = serde_json::Map::new();
+             for col in row.column_names() {
+                 map.insert(col.to_string(), crate::crud::row_value(&row, &col));
+             }
+             results.push(serde_json::Value::Object(map));
+        }
+        
+        lua.to_value(&results)
     }
 }
