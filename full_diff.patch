-        add: add.is_some(),
-        freq: normalize_choice(freq, &changefreq_values(), "never"),
-        prio: normalize_choice(prio, &priority_values(), "0.5"),
-    }
-}
-
-fn normalize_choice(value: String, allowed: &[&str], default: &str) -> String {
-    if allowed.contains(&value.as_str()) {
-        value
-    } else {
-        default.to_string()
-    }
-}
