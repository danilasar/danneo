<div class="cont clearfix">
    <div class="conttitle">
        <h2>{title}</h2>
    </div>
    <div class="conttext clearfix">   
        <!--if:icon:yes--><div class="icon">{icon}</div><!--if-->
        {desc}
    </div>
    <div class="mediaview">
        {media}  
    </div>  
    <div class="conttext clearfix">
        {text}
    </div>
    <div class="continfo">
        {langcol}: {total} <i>&#8260;</i> <!--if:date:yes-->{public}: {time} <i>&#8260;</i> <!--if-->{langhits}: {hits}
    </div>
</div> 
