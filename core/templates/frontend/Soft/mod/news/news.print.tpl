<div id="print">
    <div class="printrow">
        {time} 
        <div class="title">{title}</div>
        <div class="text">{image}{text}</div>
    </div>
    <div class="printline">
        <p>{copytext}</p>
        <p>{print_notice}</p>
    </div>
    <p>{url}</p>
</div>
